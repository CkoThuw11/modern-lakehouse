COMPOSE_PROJECT_NAME=data-platform

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Iceberg REST Catalog (backend Postgres)
ICEBERG_REST_DB_USER=iceberg
ICEBERG_REST_DB_PASSWORD=iceberg123
ICEBERG_REST_DB_NAME=iceberg_catalog

# Source Postgres (BikeStores, CDC-enabled)
POSTGRES_USER=bikestores
POSTGRES_PASSWORD=bikestores123
POSTGRES_DB=bikestores
POSTGRES_PORT=5432

# Airflow (orchestration) — metadata DB + web login
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow123
AIRFLOW_DB_NAME=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_WEBSERVER_PORT=8088
AIRFLOW_FERNET_KEY=uAWSBH4g9vc7bI-4ncfJ-QM9Dk3p1XwMe-014OpxdEE=

# Host ports (left side of "host:container") — change only on a local port clash.
# Container-side ports are fixed by each image and used as-is inside the network.
KAFKA_PORT=9094
SCHEMA_REGISTRY_PORT=8081
AKHQ_PORT=8080
KAFKA_CONNECT_PORT=8083
ICEBERG_REST_PORT=8181
SPARK_THRIFT_PORT=10000
SPARK_UI_PORT=4040
TRINO_PORT=8085
