COMPOSE_PROJECT_NAME=data-platform

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Iceberg REST Catalog (backend Postgres)
ICEBERG_REST_DB_USER=iceberg
ICEBERG_REST_DB_PASSWORD=iceberg123
ICEBERG_REST_DB_NAME=iceberg_catalog

# Source Postgres (BikeStores, CDC-enabled)
POSTGRES_USER=bikestores
POSTGRES_PASSWORD=bikestores123
POSTGRES_DB=bikestores
POSTGRES_PORT=5432

# Airflow (orchestration) — metadata DB + web login
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow123
AIRFLOW_DB_NAME=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_WEBSERVER_PORT=8088
# Encrypts connections/variables in the metadata DB; webserver + scheduler must share it.
# Generate a fresh one with:  openssl rand -base64 32 | tr '+/' '-_'
AIRFLOW_FERNET_KEY=uAWSBH4g9vc7bI-4ncfJ-QM9Dk3p1XwMe-014OpxdEE=

# Observability (Grafana). Prometheus needs no credentials.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
